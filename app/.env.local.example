# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only -- NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Used only in Phase 4/5 backend routes that need to bypass RLS for
# AI-driven curriculum/resource ingestion (e.g. writing draft rows as
# the "system", not as a logged-in admin user).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CRON_SECRET for /api/jobs/process endpoint
# Used by scheduled job processor to authorize cron invocations.
# Must match the value set in your deployment platform's environment
# variables. Without it, POST /api/jobs/process returns HTTP 401.
CRON_SECRET=your-cron-secret

# Phase 4/5 -- Anthropic API key for curriculum-matching and resource
# classification calls.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Azure AI Foundry (OpenAI-compatible) -- alternative provider for GPT-4.1 mini etc.
# Set AI_PROVIDER=azure to use this instead of Anthropic or OpenRouter.
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name (e.g., gpt-4.1-mini)
# AZURE_OPENAI_API_VERSION=2024-12-01-preview (optional, defaults to this version)
# AZURE_OPENAI_USE_V1_ENDPOINT=false (optional, set true to use /openai/v1/chat/completions endpoint)
